# TMDB API Configuration (Server-side only - DO NOT prefix with NEXT_PUBLIC_)
TMDB_API_KEY=your_tmdb_api_key
TMDB_API_READ_ACCESS_TOKEN=your_tmdb_read_access_token

# Streaming Configuration
# Provider type: 'embed' for iframe embed, 'direct' for direct video URL
STREAM_PROVIDER=embed

# URL pattern for movie streaming
# Placeholders: {id} = TMDB ID
# Example: https://provider-url/movie/{id}
STREAM_MOVIE_URL_PATTERN=

# URL pattern for TV show streaming
# Placeholders: {id} = TMDB ID, {season} = season number, {ep} = episode number
# Example: https://provider-url/tv/{id}/{season}/{ep}
STREAM_TV_URL_PATTERN=
